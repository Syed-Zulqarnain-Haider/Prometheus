# Copy to .env for local development. NEVER commit a real .env (see .gitignore).
# In production these are provided by GCP Secret Manager / Cloud Run env, not a file.

ENV=development

# Async SQLAlchemy DSN (note the +asyncpg driver).
# In production use Neon's POOLED endpoint — the host contains "-pooler"
# (e.g. ...-pooler.eu-central-1.aws.neon.tech) — for lower per-request connection
# latency. The app logs a warning at startup if a Neon host lacks "-pooler".
DATABASE_URL=postgresql+asyncpg://prometheus:prometheus@localhost:5432/prometheus

REDIS_URL=redis://localhost:6379/0

# Exact frontend origin(s), comma-separated. No wildcards.
CORS_ORIGINS=http://localhost:3000

# Observability. SENTRY_DSN is a SECRET; absent → Sentry stays off (the app still emits
# trace-correlated structured logs and returns a request_id on errors). Set LOG_JSON=true in
# production so a log aggregator gets one JSON object per line.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
LOG_LEVEL=INFO
LOG_JSON=false

# Firebase project id used to verify ID-token audience. In production set this on
# Cloud Run; locally, firebase-admin reads GOOGLE_APPLICATION_CREDENTIALS instead
# (see docs/RUNBOOK-LOCAL.md). Leave blank if your local flow doesn't verify tokens.
# GOOGLE_CLOUD_PROJECT=your-firebase-project-id

# SMTP for admin email alerts (e.g. a new app discovered on refresh). Optional — if unset,
# email is a graceful no-op and the in-app notification still fires. smtp_password is a SECRET
# (use Secret Manager in prod). Email sends only when SMTP_HOST and SMTP_FROM are both set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Ask-your-data assistant (chatbot). Every provider key is a SECRET (Secret Manager in prod).
# The assistant becomes available only when at least one provider key is set AND an admin
# turns on the "Ask-your-data assistant" operational setting. WHICHEVER provider the user
# picks, it answers strictly from what the asking user is permitted to see (their RBAC scope
# + metric permissions) and never generates SQL. Each provider appears in the in-app dropdown
# only when its key is present. Model ids are overridable (third-party names change over time).
#   Claude (Anthropic):
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-opus-5
#   ChatGPT (OpenAI):
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
#   Gemini (Google, via its OpenAI-compatible endpoint):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
#   Grok (xAI, OpenAI-compatible endpoint):
XAI_API_KEY=
GROK_MODEL=grok-2-latest
